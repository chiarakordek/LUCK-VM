rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Config: lectura pública, escritura solo autenticados
    match /admin/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Secciones: lectura pública, escritura solo autenticados
    match /secciones/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
